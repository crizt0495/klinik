# ── Database ────────────────────────────────────────────────────────────────
# URL pooled Neon untuk runtime (koneksi WebSocket untuk transaksi ACID)
DATABASE_URL=postgresql://user:pass@host-pooler/db
# URL biasa (bukan pooled) — hanya dipakai untuk db:push / db:migrate bila perlu
# DATABASE_URL_PLAIN=postgresql://user:pass@host/db

# Gunakan PGlite lokal (tanpa server) untuk development/test — abaikan di produksi
# DB_DRIVER=pglite
# PGLITE_DATA_DIR=.pglite

# ── BPJS Kesehatan (VClaim) ──────────────────────────────────────────────────
# Opsional — jika dikosongkan, modul BPJS berjalan dalam mode mock/local.
# BPJS_ENABLED=false
# BPJS_MOCK=true
# BPJS_CONS_ID=
# BPJS_SECRET_KEY=
# BPJS_USER_KEY=
# BPJS_BASE_URL=https://dvlp.bpjs-kesehatan.go.id:9081
# BPJS_FASKES_CODE=
# BPJS_FASKES_NAME=
# BPJS_EXTRA_HEADERS={"X-Additional":"value"}

# ── Penyimpanan file (opsional, default: lokal) ─────────────────────────────
# Saat token Vercel Blob diisi, upload dokumen dipindahkan ke Vercel Blob.
# BLOB_READ_WRITE_TOKEN=
# STORAGE_ENDPOINT=